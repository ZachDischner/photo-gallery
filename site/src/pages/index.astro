---
import { IMAGE_BASE } from '../config';
import fs from 'node:fs';
import path from 'node:path';

const photosDir = path.join(process.cwd(), 'public/photos');
const galleries = fs.readdirSync(photosDir, { withFileTypes: true })
  .filter(d => d.isDirectory())
  .map(d => d.name)
  .sort();
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Zach's Photos</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #111; color: #fff; min-height: 100vh; }
    header { text-align: center; padding: 3rem 2rem 2rem; }
    h1 { font-weight: 300; font-size: 2.5rem; margin-bottom: 0.5rem; }
    .contact { color: #888; font-size: 0.9rem; }
    .contact a { color: #aaa; text-decoration: none; }
    .contact a:hover { color: #fff; }
    main { max-width: 1400px; margin: 0 auto; padding: 0 2rem 3rem; }
    .galleries { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
    .gallery { position: relative; aspect-ratio: 4/3; overflow: hidden; border-radius: 12px; }
    .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
    .gallery:hover img { transform: scale(1.05); }
    .gallery-title { position: absolute; bottom: 0; left: 0; right: 0; padding: 1rem; background: linear-gradient(transparent, rgba(0,0,0,0.8)); font-size: 1.1rem; }
    a { color: inherit; text-decoration: none; }
  </style>
</head>
<body>
  <header>
    <h1>Zach Dischner</h1>
    <p class="contact">
      <a href="mailto:zach.dischner@gmail.com">zach.dischner@gmail.com</a> · 
      <a href="https://github.com/zachdischner">github</a> · 
      <a href="https://linkedin.com/in/zachdischner">linkedin</a>
    </p>
  </header>
  <main>
    <div class="galleries">
    {galleries.map(name => {
      const slug = encodeURIComponent(name);
      const files = fs.readdirSync(path.join(photosDir, name)).filter(f => /\.(jpe?g|png|webp)$/i.test(f) && !f.includes('_thumb'));
      const cover = files[0];
      const thumbName = cover?.replace(/\.([^.]+)$/, '_thumb.$1');
      const thumbExists = cover && fs.existsSync(path.join(photosDir, name, thumbName));
      const imgSrc = thumbExists ? `${IMAGE_BASE}/${name}/${thumbName}` : `${IMAGE_BASE}/${name}/${cover}`;
      return (
        <a href={`/gallery/${slug}`} class="gallery">
          {cover && <img src={imgSrc} alt={name} loading="lazy" />}
          <div class="gallery-title">{name}</div>
        </a>
      );
    })}
    </div>
  </main>
</body>
</html>
